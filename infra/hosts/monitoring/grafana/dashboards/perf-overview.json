{
 "uid": "perf-overview",
 "title": "Perf overview",
 "schemaVersion": 39,
 "editable": true,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "timezone": "browser",
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Load (locust)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Users / RPS",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "locust_users",
     "legendFormat": "users",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum(locust_requests_current_rps)",
     "legendFormat": "rps",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "C",
     "expr": "sum(locust_requests_current_fail_per_sec)",
     "legendFormat": "fail/s",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Response time (aggregated)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "locust_requests_current_response_time_percentile_50",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "locust_requests_current_response_time_percentile_95",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "C",
     "expr": "sum(locust_requests_avg_response_time * locust_requests_current_rps) / sum(locust_requests_current_rps)",
     "legendFormat": "avg (rps-weighted)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Where does a request's time go?",
   "description": "If DB time per request tracks response time, Postgres dominates. Gap = time in Vikunja (Go, permission checks, JSON) + network.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(locust_requests_avg_response_time * locust_requests_current_rps) / sum(locust_requests_current_rps)",
     "legendFormat": "avg locust response time",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum(rate(pg_stat_statements_kind_total_exec_time[30s])) / sum(locust_requests_current_rps)",
     "legendFormat": "DB exec time per request",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Avg response time by endpoint",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
